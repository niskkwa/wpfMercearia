<Window x:Class="WpfMercearia.CadastroProdutosWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="Cadastro de Produtos"
     Height="650"
     Width="900"
     WindowStartupLocation="CenterOwner">


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TITULO -->

        <TextBlock
        Grid.Row="0"
        Text="Cadastro de Produtos"
        FontSize="26"
        FontWeight="Bold"
        Margin="0,0,0,10"/>


        <!-- AREA DE CADASTRO -->

        <Border
        Grid.Row="0"
        Margin="0,50,0,0"
        Padding="15"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- CODIGO -->

                <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Código de barras:"
                VerticalAlignment="Center"
                Margin="0,5"/>

                <TextBox
                x:Name="txtCodigo"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5"
                Padding="6"/>


                <!-- NOME -->

                <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="Nome:"
                VerticalAlignment="Center"
                Margin="0,5"/>

                <TextBox
                x:Name="txtNome"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                Padding="6"/>


                <!-- PRECO -->

                <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Preço:"
                VerticalAlignment="Center"
                Margin="0,5"/>

                <TextBox
                x:Name="txtPreco"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                Padding="6"/>


                <!-- UNIDADE -->

                <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Text="Unidade:"
                VerticalAlignment="Center"
                Margin="0,5"/>

                <TextBox
                x:Name="txtUnidade"
                Grid.Row="0"
                Grid.Column="3"
                Margin="5"
                Padding="6"
                Text="un"
                IsReadOnly="True"/>


                <!-- PESO -->

                <CheckBox
                x:Name="chkVendidoPorPeso"
                Grid.Row="1"
                Grid.Column="3"
                Content="Vendido por peso"
                VerticalAlignment="Center"
                Margin="5"
                Checked="chkVendidoPorPeso_Checked"
                Unchecked="chkVendidoPorPeso_Unchecked"/>


                <!-- BOTOES -->

                <StackPanel
                Grid.Row="2"
                Grid.Column="3"
                Orientation="Horizontal"
                Margin="5">

                    <Button
                    x:Name="btnCadastrar"
                    Content="Cadastrar"
                    Height="40"
                    Width="115"
                    Margin="0,0,5,0"
                    Background="#2E7D32"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="btnCadastrar_Click"/>

                    <Button
                    x:Name="btnSalvarEdicao"
                    Content="Salvar Alterações"
                    Height="40"
                    Width="130"
                    Background="#1565C0"
                    Foreground="White"
                    FontWeight="Bold"
                    Visibility="Collapsed"
                    Click="btnSalvarEdicao_Click"/>

                </StackPanel>


                <!-- CANCELAR -->

                <Button
                x:Name="btnCancelarEdicao"
                Grid.Row="3"
                Grid.Column="3"
                Content="Cancelar edição"
                Height="35"
                Margin="5"
                Visibility="Collapsed"
                Click="btnCancelarEdicao_Click"/>

            </Grid>

        </Border>


        <!-- LISTA -->

        <Border
        Grid.Row="2"
        Padding="10"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock
                Grid.Row="0"
                Text="Produtos cadastrados"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10"/>


                <!-- DATAGRID -->

                <DataGrid
                x:Name="dgProdutos"
                Grid.Row="1"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single"
                Margin="0,5">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                        Header="Código"
                        Binding="{Binding Codigo}"
                        Width="180"/>

                        <DataGridTextColumn
                        Header="Nome"
                        Binding="{Binding Nome}"
                        Width="*"/>

                        <DataGridTextColumn
                        Header="Preço"
                        Binding="{Binding Preco, StringFormat=C2}"
                        Width="120"/>

                        <DataGridCheckBoxColumn
                        Header="Por peso"
                        Binding="{Binding VendidoPorPeso}"
                        Width="100"/>

                        <DataGridTextColumn
                        Header="Unidade"
                        Binding="{Binding Unidade}"
                        Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>


                <!-- BOTOES DA TABELA -->

                <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">

                    <Button
                    x:Name="btnEditar"
                    Content="Editar selecionado"
                    Height="35"
                    Padding="15,5"
                    Background="#1565C0"
                    Foreground="White"
                    Click="btnEditar_Click"/>

                    <Button
                    x:Name="btnExcluir"
                    Content="Excluir selecionado"
                    Height="35"
                    Padding="15,5"
                    Margin="10,0,0,0"
                    Background="#C62828"
                    Foreground="White"
                    Click="btnExcluir_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>

