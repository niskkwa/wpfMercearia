<Window x:Class="WpfMercearia.PagamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forma de Pagamento"
        Height="400"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Forma de pagamento"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,15"/>

        <TextBlock
            x:Name="txtTotalPagamento"
            Grid.Row="1"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2">

            <RadioButton
                x:Name="rbDinheiro"
                Content="Dinheiro"
                FontSize="16"
                Margin="0,5"
                IsChecked="True"
                Checked="FormaPagamento_Checked"/>

            <StackPanel
                x:Name="painelDinheiro"
                Margin="20,5,0,10">

                <TextBlock
                    Text="Valor recebido:"
                    Margin="0,0,0,5"/>

                <TextBox
                    x:Name="txtValorRecebido"
                    TextChanged="txtValorRecebido_TextChanged"/>

                <TextBlock
                    Text="Troco:"
                    Margin="0,10,0,0"
                    FontWeight="SemiBold"/>

                <TextBlock
                    x:Name="txtTroco"
                    Text="R$ 0,00"
                    FontSize="22"
                    FontWeight="Bold"/>

            </StackPanel>

            <RadioButton
                x:Name="rbPix"
                Content="PIX"
                FontSize="16"
                Margin="0,5"
                Checked="FormaPagamento_Checked"/>

            <RadioButton
                x:Name="rbCartao"
                Content="Cartão"
                FontSize="16"
                Margin="0,5"
                Checked="FormaPagamento_Checked"/>

        </StackPanel>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancelar"
                Width="100"
                Margin="0,0,10,0"
                Click="btnCancelar_Click"/>

            <Button
                Content="Finalizar"
                Width="100"
                Background="#1565C0"
                Foreground="White"
                Click="btnFinalizar_Click"/>

        </StackPanel>

    </Grid>

</Window>