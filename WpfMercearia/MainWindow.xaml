<Window x:Class="WpfMercearia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caixa - Mercearia"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ========================= -->
        <!-- ENTRADA DE PRODUTOS -->
        <!-- ========================= -->
        <StackPanel Grid.Column="0">
            <!-- BOTÃO DE PRODUTOS -->
            <Button x:Name="btnProdutos" Content="Produtos" HorizontalAlignment="Left" Padding="15,8" Margin="0,0,0,15" Click="btnProdutos_Click"/>
            <Button x:Name="btnRelatorios" Content="Relatórios" HorizontalAlignment="Left" Padding="15,8" Margin="0,0,0,15" Click="btnRelatorios_Click"/>
            <Button x:Name="btnSair" Content="Sair" HorizontalAlignment="Left" Padding="15,8" Margin="0,0,0,15" Background="#C62828" Foreground="White" Click="btnSair_Click"/>
            <GroupBox Header="Leitura de código de barras / QR Code">
                <StackPanel>
                    <TextBlock Text="Aponte o leitor e escaneie o produto:" Margin="0,0,0,6" Foreground="Gray"/>
                    <TextBox x:Name="txtCodigoBarras" KeyDown="txtCodigoBarras_KeyDown"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Pesagem manual de frutas">
                <StackPanel>
                    <TextBlock Text="Fruta:" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtBuscaFruta" TextChanged="txtBuscaFruta_TextChanged" ToolTip="Digite o nome da fruta" Margin="0,0,0,4"/>
                    <ListBox x:Name="lstFrutas" DisplayMemberPath="Nome" SelectionChanged="lstFrutas_SelectionChanged" MaxHeight="120" Visibility="Collapsed"/>
                    <TextBlock Text="Peso (kg):" Margin="0,10,0,4"/>
                    <TextBox x:Name="txtPeso"/>
                    <Button x:Name="btnAdicionarPeso" Content="Adicionar ao carrinho" Background="#2E7D32" Foreground="White" Click="btnAdicionarPeso_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Produtos sem código de barras">
                <StackPanel>
                    <TextBlock Text="Produto:" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtBuscaProduto" TextChanged="txtBuscaProduto_TextChanged" ToolTip="Digite o nome do produto" Margin="0,0,0,4"/>
                    <ListBox x:Name="lstProdutos" DisplayMemberPath="Nome" SelectionChanged="lstProdutos_SelectionChanged" MaxHeight="120" Visibility="Collapsed"/>
                    <Button x:Name="btnAdicionarProduto" Content="Adicionar ao carrinho" Background="#2E7D32" Foreground="White" Click="btnAdicionarProduto_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <!-- ========================= -->
        <!-- CARRINHO -->
        <!-- ========================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="dgCarrinho" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Produto.Nome}" Width="*"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, StringFormat=N3}" Width="120"/>
                    <DataGridTextColumn Header="Preço" Binding="{Binding PrecoUnitario, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="btnRemoverItem" Grid.Row="1" Content="Remover item selecionado" HorizontalAlignment="Right" Click="btnRemoverItem_Click"/>
            <!-- ========================= -->
            <!-- TOTAL -->
            <!-- ========================= -->
            <Border Grid.Row="2" Background="#F5F5F5" Padding="15" Margin="0,15,0,0" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL" FontSize="14" Foreground="Gray"/>
                        <TextBlock x:Name="txtTotal" Text="R$ 0,00" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnCancelarVenda" Content="Cancelar Venda" Background="#C62828" Foreground="White" Margin="0,0,10,0" Click="btnCancelarVenda_Click"/>
                        <Button x:Name="btnFinalizarVenda" Content="Finalizar Venda" Background="#1565C0" Foreground="White" Click="btnFinalizarVenda_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>